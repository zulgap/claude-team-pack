#!/bin/sh
# 커밋 «전» 유출 차단 — 이 레포는 PUBLIC 이다.
#
# CI(Tier K)는 이미 막고 있지만, 그건 «올린 뒤»라 git 이력에는 남는다.
# 2026-08-16 실측: PR 로 지운 파일이 `git show <sha>^:<경로>` 로 그대로 복원됐다.
# 여기서 막으면 이력에도 안 남는다.
#
# 켜기:  git config core.hooksPath .githooks
# 끄기:  git config --unset core.hooksPath
# 이번만 건너뛰기: git commit --no-verify

files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

command -v node >/dev/null 2>&1 || {
  echo "⚠️  node 가 없어 유출 검사를 건너뛴다 — CI(Tier K)가 2차로 막는다." >&2
  exit 0
}

# shellcheck disable=SC2086
node "$(git rev-parse --show-toplevel)/scripts/leak-scan.js" --staged $files
